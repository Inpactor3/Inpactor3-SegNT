# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Notebooks
.ipynb_checkpoints/

# Modelos y datos pesados
models/*.pt
models/*.safetensors
models/*.bin
models/*.hdf5
models/*.npy
data/processed/*.parquet
data/processed/*.arrow
data/raw/*.fa.gz
data/raw/*.fasta.gz
data/raw/TAIR10_chr1.fasta         # el original de 20 MB (regenerable)
data/raw/TAIR10.fasta              # completo cuando lo bajemos (~120 MB)
data/raw/PanTEon_Database_v1.6.2.fasta   # 992 MB — se descarga de Zenodo

# TAIR10 completo — regenerable con scripts/download_backgrounds.sh
data/tair10_full/*.fasta
data/tair10_full/*.fa
data/tair10_full/inpactor2_out/Inpactor2_library.fasta

# Dataset común
data/common_dataset/genomes/*.fasta        # 2.2 GB, se regenera con download_backgrounds.sh
data/common_dataset/inpactor2_format/*.fasta   # 460 MB, se regenera con export_inpactor2_format.py
!data/common_dataset/manifest.jsonl        # SÍ versionar (3 MB, útil)
!data/common_dataset/panteon_ltr_subset.fasta  # SÍ versionar (30 MB, subset usado)

# El pseudo-FASTA (20 MB) y el .tab (1 KB) SÍ los versionamos para
# que Colab clone y arranque directo, sin descargas adicionales.
!data/raw/TAIR10_pseudo.fasta
!data/raw/Inpactor2_predictions_pseudo.tab
!data/raw/Inpactor2_predictions.tab

# Resultados grandes (mantenemos reportes .md y .tab pequeños)
results/**/*.fasta
results/**/*.h5

# HuggingFace cache
.cache/
hf_cache/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# ============================================================
# Agregados · pipeline nuevo con RepeatMasker + PanTEon
# ============================================================

# Entorno Python local temporal
.venv_slide/

# Genomas descargados (regenerables con scripts)
data/pilot_genomes/*.fasta
data/pilot_genomes/*.fa.gz
data/validation_genomes/*.fasta
data/validation_genomes/*.fa.gz

# Bibliotecas PanTEon filtradas (regenerables con filter_panteon_*.py)
data/panteon_libraries/*.fasta

# Anotaciones externas (bajar con download_curated_te.sh)
data/curated_te/*.gff3
data/curated_te/*.gff
data/curated_te/*.gff.gz
data/curated_te/*.txt
data/curated_te/*.bed
data/curated_te/*.gz
data/curated_te/*.h5

# Anotaciones de referencia Ensembl (regenerables)
data/reference_annotations/*.gff3
data/reference_annotations/*.gff
data/reference_annotations/*.gff.gz

# Outputs grandes de RepeatMasker (regenerables)
results/rm_pilots/*/*.out
results/rm_pilots/*/*.out.gff
results/rm_pilots/*/*.masked
results/rm_pilots/*/*.cat.gz
results/rm_pilots/*/*.tbl
# Pero SÍ versionamos los BEDs limpios ya procesados:
!annotations/*.bed
!annotations/*.summary.json

